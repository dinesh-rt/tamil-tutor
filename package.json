{
  "name": "tamil-tutor",
  "version": "1.0.0",
  "description": "Offline-friendly Tamil + English word app for toddlers \u2014 no build step, no dependencies.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "python3 tools/serve.py",
    "serve": "python3 tools/serve.py",
    "check": "node tools/check-data.js",
    "verify": "python3 tools/verify.py",
    "release": "python3 tools/verify.py --builds --stamp",
    "test": "node tools/run-tests.js",
    "icons": "python3 tools/make-icons.py",
    "voices": "python3 tools/make-voice-pack.py",
    "bundle": "python3 tools/build-single-file.py",
    "portable": "python3 tools/build-portable.py",
    "site": "python3 tools/build-site.py",
    "share": "python3 tools/serve.py 8090 dist/portable"
  }
}
